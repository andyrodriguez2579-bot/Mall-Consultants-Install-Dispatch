# =============================================================================
# MACA Consultants Install Dispatch — environment configuration
# =============================================================================
# Copy to .env.local for development. Never commit a filled-in copy.
#
#   cp .env.example .env.local
#
# The only values required to run the application are the three Supabase keys.
# Leave the Twilio block empty and SMS runs in development mode: messages are
# recorded and printed to the server console, including the secure links, so
# the whole dispatch and acceptance flow works with no Twilio account.

# -----------------------------------------------------------------------------
# Supabase  (required)
# -----------------------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/publishable key. Safe to expose to the browser: it can only do what
# row-level security allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key. Bypasses row-level security completely.
# Server-side only — never prefix it with NEXT_PUBLIC_, and never import it into
# a Client Component. On Vercel, mark it as a sensitive environment variable.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute base URL used to build the offer links that go out by SMS. A relative
# URL is not an option in a text message.
# On Vercel this is derived from VERCEL_URL automatically; set it explicitly for
# a custom domain so links point at the real host.
APP_BASE_URL=http://localhost:3000

# How long a dispatch round stays open, in hours. Also the default in the
# dispatch form, where it can be overridden per job.
OFFER_TTL_HOURS=4

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
# 'dev'    — log messages to the console and the database, send nothing (default)
# 'twilio' — send for real
SMS_DRIVER=dev

# Required only when SMS_DRIVER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Set exactly one of these. A Messaging Service is preferred in production: it
# handles number pooling, sticky sender, and compliance.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Contractors can ask for a sign-in link by email as well as by text, so that
# declining SMS never costs anyone access to their own account.
#
# 'dev'    — record and print it, send nothing. The link is readable in
#            Admin > Messages, which is enough to walk the whole flow.
# 'resend' — send for real
EMAIL_DRIVER=dev

# Required only when EMAIL_DRIVER=resend.
RESEND_API_KEY=

# Must be an address on a domain verified with Resend. An unverified sender is
# accepted by the API and then quietly not delivered.
EMAIL_FROM="Mall Consultants <dispatch@example.com>"

# -----------------------------------------------------------------------------
# Automation (n8n)
# -----------------------------------------------------------------------------
# Shared secret for /api/automation/*, which n8n calls when an installation
# email arrives. Sent as `Authorization: Bearer …`.
#
# Required -- the endpoints refuse every request until it is set, rather than
# falling open on the deployment where somebody forgot. At least 24 characters.
# Generate one with:  openssl rand -base64 32
AUTOMATION_API_KEY=

# -----------------------------------------------------------------------------
# Scheduled tasks
# -----------------------------------------------------------------------------
# Shared secret for /api/cron/expire-offers, sent as `Authorization: Bearer …`.
# Vercel Cron supplies this header automatically from the same variable.
# Generate one with:  openssl rand -base64 32
# In production the endpoint refuses to run if this is unset.
CRON_SECRET=
